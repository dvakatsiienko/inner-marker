{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "extends": ["biome-config-polished"],
  "files": {
    "ignoreUnknown": false,
    "includes": ["!**/public/**/*"]
  },

  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },

  "vcs": {
    "clientKind": "git",
    "defaultBranch": "master",
    "enabled": true,
    "useIgnoreFile": true
  }
}
