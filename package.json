    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cva": "1.0.0-beta.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "lefthook": "2.1.12",
    "oxc-transform-react": "0.145.0",
    "tailwindcss": "4.3.3",
